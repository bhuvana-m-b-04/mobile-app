# Login Tracker — backend environment template
# Copy this file to .env and fill in your values.
# This file IS committed to GitLab — keep all values as placeholders.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# Bell internal SQL Server (same host as other BCE internal tools)
DATABASE_URL=mssql+pyodbc://DB_USERNAME:DB_PASSWORD@cwypwd-4083.bell.corp.bce.ca,1433/LOGIN_TRACKER_DEV?driver=ODBC+Driver+17+for+SQL+Server&encrypt=yes&trustServerCertificate=yes

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30

SECRET_KEY=change-this-to-a-long-random-secret-string-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
